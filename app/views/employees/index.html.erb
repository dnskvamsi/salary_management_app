<h1 class="h3 fw-bold text-center pb-2">Employees</h1>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <%= link_to "View Stats here", stats_employees_path, class: "btn btn-primary" %>
    </div>

    <div>
      <%= link_to "＋ New Employee", new_employee_path,
      class: "btn btn-primary" %>
      <span class="badge bg-secondary"><%= Employee.count %> total</span>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>Name</th>
          <th>Job Title</th>
          <th>Salary</th>
          <th>Address</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @employees.any? %>
          <%= render @employees %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center text-muted py-4">No employees found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="d-flex justify-content-between align-items-center mt-4">
    <p class="text-muted mb-0">
      Showing
      <strong><%= @employees.offset_value + 1 %></strong>
      –
      <strong><%= [@employees.offset_value + @employees.length, @employees.total_count].min %></strong>
      of
      <strong><%= @employees.total_count %></strong>
      employees
    </p>
    <%= paginate @employees %>
  </div>
</div>